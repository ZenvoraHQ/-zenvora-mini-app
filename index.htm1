html>
<html lang="fa">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZENVORA Cosmic Finance</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--gold:#f2ce79;--purple:#a77aff;--bg:#080817}

body{
 background:var(--bg);color:white;font-family:Arial,sans-serif;
 min-height:100vh;overflow-x:hidden;padding-bottom:100px;
}

body:before{
 content:"";position:fixed;inset:0;z-index:-3;
 background:radial-gradient(ellipse at 50% 20%,#35245c,transparent 55%),
 radial-gradient(ellipse at 10% 90%,#29143f,transparent 40%),
 linear-gradient(150deg,#080817,#111329,#080817);
}

.stars{
 position:fixed;inset:0;z-index:-2;pointer-events:none;
 background-image:
 radial-gradient(2px 2px at 20% 30%,white,transparent),
 radial-gradient(2px 2px at 70% 20%,#d6b5ff,transparent),
 radial-gradient(1px 1px at 80% 70%,white,transparent),
 radial-gradient(2px 2px at 35% 85%,#f2ce79,transparent);
 background-size:180px 180px;
 animation:stars 30s linear infinite;
}

@keyframes stars{to{background-position:180px 180px}}

header{
 display:flex;justify-content:space-between;align-items:center;
 padding:17px 15px;border-bottom:1px solid #ffffff17;
}

.logo{font-size:23px;font-weight:900;letter-spacing:3px;color:var(--gold)}

.balance{
 border:1px solid #f2ce7966;border-radius:25px;
 padding:9px 12px;color:var(--gold);background:#f2ce7910;font-size:12px;
}

main{max-width:520px;margin:auto;padding:17px}

.page{display:none;animation:fade .35s ease}
.page.active{display:block}

@keyframes fade{
 from{opacity:0;transform:translateY(12px)}
 to{opacity:1;transform:none}
}

.welcome{color:#aaa9c3;font-size:12px;margin-top:9px;letter-spacing:1px}
h1{font-size:27px;margin:10px 0}
.gold{color:var(--gold)}

.hero{
 position:relative;overflow:hidden;text-align:center;
 margin-top:18px;padding:20px 15px;border-radius:25px;
 border:1px solid #a77aff55;
 background:linear-gradient(145deg,#211b42,#151328,#342047);
 box-shadow:0 15px 45px #0005;
}

.hero:before{
 content:"";position:absolute;width:230px;height:230px;
 background:#a77aff25;filter:blur(55px);
 border-radius:50%;top:0;left:50%;transform:translateX(-50%);
}

.planet{
 width:150px;height:150px;margin:15px auto 25px;
 position:relative;border-radius:50%;
 background:
 radial-gradient(circle at 30% 25%,#fff 0%,#e5c9ff 4%,transparent 15%),
 radial-gradient(circle at 70% 65%,#b68cff 0%,#8050c6 25%,#35225f 60%,#10132c 85%);
 box-shadow:inset -22px -17px 30px #050510,
 0 0 35px #a77aff99,0 0 75px #a77aff44;
 animation:planet 18s linear infinite;
}

.planet:after{
 content:"";position:absolute;inset:-15px -30px;
 border:2px solid #f2ce79aa;border-radius:50%;
 transform:rotate(-25deg) scaleY(.35);
 box-shadow:0 0 15px #f2ce7955;
}

.planet:before{
 content:"";position:absolute;width:28px;height:28px;
 border-radius:50%;background:#fff3;top:35px;left:35px;filter:blur(8px);
}

@keyframes planet{to{transform:rotate(360deg)}}

.hero h2,.hero p,.hero button{position:relative}
.hero h2{font-size:22px}
.hero p{color:#bbb8d4;font-size:12px;margin-top:8px}

.btn{
 border:0;border-radius:13px;padding:13px 18px;
 color:#171020;font-weight:bold;
 background:linear-gradient(100deg,#f2ce79,#a77aff);
 box-shadow:0 0 20px #a77aff33;
 cursor:pointer;margin-top:16px;
}

.btn:active{transform:scale(.96)}

.section-title{font-size:17px;margin:24px 0 13px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}

.card{
 border:1px solid #ffffff18;border-radius:18px;
 padding:16px;background:#19192dbb;
 backdrop-filter:blur(12px);box-shadow:0 8px 25px #0003;
}

.card small{color:#a9a8bf;font-size:11px}
.card strong{display:block;margin-top:9px;font-size:20px}
.symbol{font-size:24px;color:var(--gold);margin-bottom:10px}
.wide{grid-column:1/-1}

.row{display:flex;justify-content:space-between;align-items:center;gap:8px}

.progress{
 height:7px;background:#ffffff19;border-radius:10px;
 margin-top:12px;overflow:hidden;
}

.progress span{
 display:block;width:36%;height:100%;border-radius:10px;
 background:linear-gradient(90deg,var(--purple),var(--gold));
}

.mountain{
 height:165px;position:relative;overflow:hidden;
 margin-top:20px;border-radius:18px;
 background:linear-gradient(#171632,#33204a);
}

.peak{
 position:absolute;bottom:-35px;width:0;height:0;
 border-left:100px solid transparent;
 border-right:100px solid transparent;
 border-bottom:165px solid #65478e;
 filter:drop-shadow(0 0 10px #a77aff77);
}

.peak:after{
 content:"";position:absolute;top:10px;left:-27px;
 border-left:27px solid transparent;
 border-right:27px solid transparent;
 border-bottom:43px solid #e5d5ff;
}

.peak.one{left:-15px}
.peak.two{left:32%;transform:scale(1.3);border-bottom-color:#382650}
.peak.three{right:-30px;border-bottom-color:#76539c}

.miner{
 position:absolute;bottom:12px;left:47%;font-size:38px;
 filter:drop-shadow(0 0 10px var(--gold));
 animation:miner 2s ease-in-out infinite;
}

@keyframes miner{50%{transform:translateY(-10px) rotate(-8deg)}}

.list-item{
 display:flex;justify-content:space-between;align-items:center;
 padding:14px 0;border-bottom:1px solid #ffffff15;font-size:13px;
 gap:10px;
}

.coin{display:flex;align-items:center;gap:10px}

.coin-icon{
 width:36px;height:36px;border-radius:12px;
 background:#ffffff12;display:grid;place-items:center;
 color:var(--gold);font-weight:bold;font-size:18px;
}

.muted{color:#aaa}

.notice{font-size:11px;color:#aaa9c0;line-height:1.7;margin-top:13px}

input,select,textarea{
 width:100%;padding:13px;margin:8px 0;
 border:1px solid #ffffff25;border-radius:11px;
 background:#111225;color:white;
}

textarea{min-height:90px;resize:vertical}
label{display:block;font-size:12px;color:#c4badb;margin-top:12px}
.action{width:100%}

.chart{
 display:flex;align-items:end;justify-content:space-around;
 height:120px;padding:12px 5px 0;gap:7px;
 border-bottom:1px solid #ffffff20;
}

.bar{
 flex:1;border-radius:7px 7px 0 0;
 background:linear-gradient(#a77aff,#eac66e);
 box-shadow:0 0 12px #a77aff44;
 animation:grow 1.5s ease;
}

@keyframes grow{from{height:0!important}}

.wallet-actions{
 display:grid;grid-template-columns:1fr 1fr;gap:12px;
 margin:18px 0;
}

.wallet-actions .btn{margin:0;width:100%}

.wallet-form{
 display:none;margin-top:15px;
 border:1px solid #a77aff55;
 background:linear-gradient(145deg,#211b42,#151328);
 border-radius:18px;padding:17px;
}

.wallet-form h2{color:var(--gold);font-size:20px;margin-bottom:12px}

.wallet-message{
 font-size:12px;line-height:1.8;margin-top:12px;color:var(--gold);
}

.tag{
 display:inline-block;padding:5px 9px;border-radius:15px;
 background:#a77aff22;color:var(--gold);font-size:10px;
 border:1px solid #a77aff55;
}

.small-btn{
 border:1px solid #a77aff66;background:#a77aff18;
 color:var(--gold);padding:8px 12px;border-radius:9px;
 cursor:pointer;font-size:11
